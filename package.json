{
    "name": "pazaryonetimi",
    "private": true,
    "packageManager": "npm@10.8.2",
    "engines": {
        "node": ">=22 <23",
        "npm": ">=10"
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "turbo run build",
        "lint": "turbo run lint",
        "generate": "npm run db:generate",
        "db:generate": "npm run generate --workspace=@pazaryonetimi/database"
    },
    "devDependencies": {
        "@prisma/config": "^7.4.2",
        "turbo": "latest"
    },
    "overrides": {
        "next": "16.2.3",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "path-to-regexp": "6.3.0",
        "picomatch": "4.0.4",
        "tar": "6.2.1",
        "rollup": "4.28.1",
        "glob": "9.3.5",
        "tmp": "0.2.3",
        "rxjs": "^7.8.1"
    },
    "optionalDependencies": {
        "@next/swc-linux-arm64-gnu": "latest",
        "@next/swc-linux-arm64-musl": "latest",
        "@tailwindcss/oxide-linux-arm64-gnu": "latest",
        "@tailwindcss/oxide-linux-arm64-musl": "latest",
        "lightningcss-linux-arm64-gnu": "latest",
        "lightningcss-linux-arm64-musl": "latest"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/core": "^11.0.1",
        "@prisma/adapter-pg": "^7.5.0",
        "pg": "^8.20.0"
    }
}
