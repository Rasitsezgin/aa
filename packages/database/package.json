{
  "name": "@pazaryonetimi/database",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@prisma/client": "^7.4.2",
    "@prisma/config": "^7.4.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.2.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.7",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "prisma": "^7.4.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "prisma:generate": "npx prisma generate",
    "generate": "npm run prisma:generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:deploy": "npx prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "npx prisma db push --force-reset && npx tsx prisma/seed.ts"
  }
}