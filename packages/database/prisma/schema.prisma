  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  backupId  String
  sourceDatabase String?
  targetDatabase String?
  status    String
  error     String?
  duration  Int?
  dryRun    Boolean?
  estimatedDurationMs Int?
  startedAt DateTime @default(now())
  endTime   DateTime?
}

model DrSettings {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  rpoMinutes Int?
  rtoMinutes Int?
  replicationEnabled Boolean?
  geoRedundancyEnabled Boolean?
  updatedAt DateTime @updatedAt
  testRestoreFrequencyDays Int?
  backupEncryption Boolean?
  encryptionAlgorithm String?
  dataRetentionYears Int?
  complianceLevel String?
}

// ==================== SEARCH ====================

model SearchHistory {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  query     String
  filters   Json?
  resultsCount Int?
  timestamp DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

model SavedSearch {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  description String?
  query     String
  filters   Json?
  isFavorite Boolean @default(false)
  usageCount Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  
  type        String   // "order", "stock", "price", "review", "system", "integration", "campaign"
  title       String
  message     String  
  severity    String   @default("info") // "info", "warning", "error", "success"
  
  isRead      Boolean  @default(false)
  readAt      DateTime?
  
  actionUrl   String?  // Link to navigate when clicked
  data        Json?    // Extra structured data
  
  createdAt   DateTime @default(now())
  
  @@index([tenantId, isRead])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ==================== FEATURE REQUEST VOTES ====================

model FeatureRequestVote {
  id               String   @id @default(uuid())
  featureRequestId String
  userId           String
  tenantId         String?
  createdAt        DateTime @default(now())
  
  @@unique([featureRequestId, userId])
  @@index([featureRequestId])
}

// ==================== WEBHOOKS ====================

model Webhook {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  url         String
  secret      String?
  events      Json? // ["order.created", "stock.updated", ...]
  headers     Json?    // Custom HTTP headers
  
  isActive    Boolean  @default(true)
  
  lastTriggered DateTime?
  lastStatus    String?  // "success", "failed"
  lastResponse  String?
  failCount     Int     @default(0)
  successCount  Int     @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([isActive])
}

// ==================== AUTOMATIONS ====================

model Automation {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  type        String   // "price-adjust", "stock-alert", "order-process", "review-reply", "campaign-trigger", "report-schedule"
  
  trigger     String   // Trigger description
  action      String   // Action description
  conditions  Json?    // Array of {field, operator, value}
  
  isActive    Boolean  @default(true)
  
  lastRun     DateTime?
  runCount    Int      @default(0)
  successRate Float    @default(100)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([isActive])
  @@index([type])
}

// ==================== CAMPAIGNS ====================

model Campaign {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  type        String   // "discount", "flash-sale", "bundle", "loyalty", "seasonal", "coupon"
  status      String   @default("draft") // "active", "paused", "scheduled", "completed", "draft"
  
  startDate   DateTime
  endDate     DateTime
  
  platforms   Json?
  products    Json? // Product IDs
  
  discount    Float?
  budget      Float    @default(0)
  spent       Float    @default(0)
  
  // Performance metrics
  impressions  Int     @default(0)
  clicks       Int     @default(0)
  conversions  Int     @default(0)
  revenue      Float   @default(0)
  roas         Float   @default(0)
  ctr          Float   @default(0)
  conversionRate Float @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([status])
  @@index([type])
  @@index([startDate, endDate])
}

// ==================== REVIEWS ====================

model Review {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  externalId  String?  // Pazaryerinden gelen orijinal yorum ID'si (duplicate önleme)

  productId   String?
  productName String

  customerName   String
  customerAvatar String?

  platform    String   // "TRENDYOL", "HEPSIBURADA", "AMAZON", "N11", "CICEKSEPETI"
  rating      Int      // 1-5
  title       String?
  comment     String

  status      String   @default("pending") // "pending", "replied", "flagged", "hidden"
  reply       String?
  repliedAt   DateTime?

  helpful     Int      @default(0)
  verified    Boolean  @default(false)
  sentiment   String?  // "positive", "negative", "neutral" — AI tarafından doldurulur

  reviewDate  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, platform, externalId])
  @@index([tenantId])
  @@index([productId])
  @@index([platform])
  @@index([rating])
  @@index([status])
}

// ==================== STORES ====================

model Store {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  platform    Platform
  shopUrl     String?
  
  status      String   @default("disconnected") // "connected", "disconnected", "syncing", "error"
  
  apiKey      String?
  apiSecret   String?
  accessToken String?
  
  lastSync    DateTime?
  syncFrequency Int?   // minutes
  autoSync    Boolean  @default(false)
  
  productCount Int     @default(0)
  orderCount   Int     @default(0)
  
  settings    Json?    // Platform-specific settings
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([platform])
  @@index([status])
}

// ==================== PAYMENTS ====================

model Payment {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  orderId     String?
  platform    String
  
  amount      Decimal  
  commission  Decimal? 
  netAmount   Decimal? 
  currency    String   @default("TRY")
  
  status      String   @default("pending") // "pending", "completed", "failed", "refunded"
  type        String   @default("sale")    // "sale", "refund", "commission", "payout"
  
  paymentMethod String?  // "credit-card", "bank-transfer", "wallet"
  transactionId String?
  
  paidAt      DateTime?
  dueDate     DateTime?
  
  metadata    Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([orderId])
  @@index([status])
  @@index([platform])
  @@index([paidAt])
}

// ==================== SHIPMENTS ====================

model Shipment {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  orderId     String
  
  carrier     String   // "Aras", "Yurtiçi", "MNG", "PTT", "UPS", "DHL"
  trackingNumber String?
  
  status      String   @default("preparing") // "preparing", "shipped", "in-transit", "delivered", "returned"
  
  senderAddress   Json?
  receiverAddress Json?
  
  weight      Float?   // kg
  dimensions  Json?    // {length, width, height}
  
  cost        Decimal? 
  currency    String   @default("TRY")
  
  estimatedDelivery DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  
  events      Json?    // Array of tracking events
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
}

// ==================== EXCHANGE RATES ====================

model ExchangeRate {
  id           String   @id @default(uuid())
  baseCurrency String   // "USD", "EUR", "GBP"
  targetCurrency String // "TRY"
  rate         Decimal  // 1 baseCurrency = rate targetCurrency
  source       String   @default("TCMB") // "TCMB", "ECB", "manual"
  date         DateTime // Kur tarihi
  
  createdAt    DateTime @default(now())
  
  @@unique([baseCurrency, targetCurrency, date])
  @@index([baseCurrency, targetCurrency])
  @@index([date])
}

// ==================== REPORTS ====================

model Report {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  type        String   // "sales", "inventory", "financial", "performance", "custom"
  description String?
  
  parameters  Json?    // Date range, filters, etc.
  data        Json?    // Generated report data
  
  format      String   @default("json") // "json", "csv", "pdf", "excel"
  fileUrl     String?  // Generated file URL
  fileSize    Int?     // bytes
  
  status      String   @default("pending") // "pending", "generating", "completed", "failed"
  
  generatedAt DateTime?
  expiresAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([type])
  @@index([status])
}

model ScheduledReport {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  type        String   // Same as Report.type
  
  schedule    String   // Cron expression or "daily", "weekly", "monthly"
  recipients  Json? // Email addresses
  format      String   @default("pdf")
  
  parameters  Json?    // Report parameters
  
  isActive    Boolean  @default(true)
  lastRun     DateTime?
  nextRun     DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([isActive])
}

// ==================== API KEYS ====================

model ApiKey {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  name        String
  key         String   @unique
  prefix      String?  // First 8 chars for display
  
  permissions Json? // ["read", "write", "delete"]
  
  isActive    Boolean  @default(true)
  
  lastUsed    DateTime?
  expiresAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([key])
  @@index([userId])
}

// ==================== BULK ACTIONS ====================

model BulkAction {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  action      String   // "price-update", "stock-update", "status-change", "delete", "export"
  
  totalItems  Int      @default(0)
  processed   Int      @default(0)
  succeeded   Int      @default(0)
  failed      Int      @default(0)
  
  status      String   @default("pending") // "pending", "processing", "completed", "failed"
  
  data        Json?    // Action parameters
  results     Json?    // Per-item results
  
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  
  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

// ==================== SEO ANALYSIS ====================

model SeoAnalysis {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  productId   String?
  url         String?
  
  score       Int      @default(0) // 0-100
  
  titleScore  Int?
  descriptionScore Int?
  keywordScore Int?
  imageScore  Int?
  
  issues      Json?    // Array of {type, severity, message, suggestion}
  keywords    Json?
  
  recommendations Json? // Array of suggestions
  
  analyzedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  
  @@index([tenantId])
  @@index([productId])
}

// ==================== PRICING RULES ====================

model PricingRule {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  description String?
  type        String   // "margin", "competitor", "dynamic", "bulk", "time-based"
  
  conditions  Json?    // When to apply
  action      Json?    // What to do (e.g., {type: "percentage", value: -5})
  
  platforms   Json? // Apply to which platforms
  categories  Json? // Apply to which categories
  
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  
  appliedCount Int     @default(0)
  lastApplied  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([isActive])
  @@index([type])
}

// ==================== PRICE EXPERIMENTS (A/B) ====================

model PriceExperiment {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  
  name        String
  status      String   @default("active") // "active", "stopped", "completed"
  
  controlPrice  Decimal
  testPrice     Decimal
  
  controlSales  Int     @default(0)
  testSales     Int     @default(0)
  controlRevenue Decimal @default(0)
  testRevenue    Decimal @default(0)
  controlViews   Int    @default(0)
  testViews      Int    @default(0)
  
  startDate   DateTime @default(now())
  endDate     DateTime?
  durationDays Int     @default(7)
  
  result      Json?   // {winner, liftPercent, significance}
  metadata    Json?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([productId])
  @@index([status])
}

// ==================== DASHBOARD LAYOUT ====================

model DashboardLayout {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  name        String   @default("default")
  layout      Json     // Widget positions and sizes
  widgets     Json?    // Widget configurations
  
  isDefault   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([tenantId, userId, name])
  @@index([tenantId])
  @@index([userId])
}

// ==================== AI İÇERİK OPTİMİZASYONU ====================

model ContentAnalysis {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  originalTitle         String
  originalDescription   String?
  platform              String   @default("TRENDYOL")
  seoScore              Int      @default(0)
  readabilityScore      Int      @default(0)
  keywordScore          Int      @default(0)
  competitivenessScore  Int      @default(0)
  overallScore          Int      @default(0)
  analysisResult        Json?
  suggestions           Json?
  detectedKeywords      Json?
  detectedIssues        Json?
  createdAt             DateTime @default(now())

  optimizations         ContentOptimization[]

  @@index([tenantId])
  @@index([productId])
  @@index([platform])
}

model ContentOptimization {
  id                    String   @id @default(uuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId             String?
  product               Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  analysisId            String?
  analysis              ContentAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  platform              String   @default("TRENDYOL")
  version               Int      @default(1)
  originalTitle         String
  originalDescription   String?
  optimizedTitle        String
  optimizedDescription  String?
  keywords              Json?
  seoScoreBefore        Int      @default(0)
  seoScoreAfter         Int      @default(0)
  improvements          Json?
  tone                  String   @default("professional")
  status                String   @default("draft") // draft, approved, applied, rejected
  aiModelUsed           String?  @default("gemini-1.5-flash")
  tokenUsage            Int?     @default(0)
  appliedAt             DateTime?
  syncedToPlatform      Boolean  @default(false)
  syncResult            Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  batchItem             ContentBatchItem?

  @@index([tenantId])
  @@index([productId])
  @@index([status])
  @@index([analysisId])
}

model ContentBatchJob {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  platform          String   @default("TRENDYOL")
  tone              String   @default("professional")
  status            String   @default("pending") // pending, processing, completed, failed
  totalProducts     Int      @default(0)
  processedProducts Int      @default(0)
  successCount      Int      @default(0)
  failCount         Int      @default(0)
  avgScoreBefore    Int?     @default(0)
  avgScoreAfter     Int?     @default(0)
  config            Json?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             ContentBatchItem[]

  @@index([tenantId])
  @@index([status])
}

model ContentBatchItem {
  id              String   @id @default(uuid())
  batchJobId      String
  batchJob        ContentBatchJob @relation(fields: [batchJobId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  optimizationId  String?  @unique
  optimization    ContentOptimization? @relation(fields: [optimizationId], references: [id], onDelete: SetNull)
  status          String   @default("pending") // pending, processing, completed, failed
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([batchJobId])
  @@index([productId])
}

model ContentTemplate {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  platform            String?
  category            String?
  tone                String   @default("professional")
  titleTemplate       String?
  descriptionTemplate String?
  promptTemplate      String?
  variables           Json?
  isDefault           Boolean  @default(false)
  usageCount          Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
}

model ContentRule {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform    String
  ruleType    String   // max_title_length, forbidden_words, required_keywords, description_format, etc.
  ruleName    String
  ruleValue   Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId, platform])
}

// ==================== DEPO YÖNETİMİ ====================

model Warehouse {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  code        String
  type        String   @default("main") // main, secondary, dropship, fulfillment
  address     String?
  city        String?
  district    String?
  phone       String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transfersFrom WarehouseTransfer[] @relation("TransferFrom")
  transfersTo   WarehouseTransfer[] @relation("TransferTo")
  stocks        WarehouseStock[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model WarehouseStock {
  id           String    @id @default(uuid())
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId    String
  quantity     Int       @default(0)
  reserved     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
}

model WarehouseTransfer {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId       String
  quantity        Int
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  reason          String?
  status          String    @default("completed") // pending, in_transit, completed, cancelled
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([tenantId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}
