generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum UserType {
  SUPERADMIN
  ADMIN
  USER
}

enum Platform {
  // Türkiye Pazaryerleri
  TRENDYOL
  AMAZON
  HEPSIBURADA
  N11
  CICEKSEPETI
  GITTIGIDIYOR
  PTTAVM
  MORHIPO
  // Global Pazaryerleri
  AMAZON_US
  AMAZON_UK
  AMAZON_DE
  AMAZON_FR
  EBAY
  ETSY
  ALIEXPRESS
  SHOPEE
  LAZADA
  WALMART
  SHOPIFY
  WOOCOMMERCE
  // Özel
  WEBSITE
  OTHER
}

enum ServiceType {
  // Kargo
  SHIPPING_ARAS
  SHIPPING_YURTICI
  SHIPPING_MNG
  SHIPPING_PTT
  SHIPPING_UPS
  SHIPPING_DHL
  SHIPPING_FEDEX
  SHIPPING_OTHER
  // Ödeme
  PAYMENT_IYZICO
  PAYMENT_PAYTR
  PAYMENT_PARAM
  PAYMENT_STRIPE
  PAYMENT_OTHER
  // E-Fatura
  EINVOICE_FORIBA
  EINVOICE_LOGO
  EINVOICE_PARASUT
  EINVOICE_EFINANS
  EINVOICE_OTHER
  // SMS
  SMS_NETGSM
  SMS_ILETIMERKEZI
  SMS_OTHER
  // E-posta
  EMAIL_SMTP
  EMAIL_SENDGRID
  EMAIL_OTHER
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  domain      String?  @unique
  slug        String?  @unique
  plan        Plan     @default(FREE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Corporate & Billing Info
  taxOffice      String?
  taxNumber      String?
  companyType    String?   // e.g., "Limited", "Anonim"
  address        String?
  city           String?
  district       String?
  postcode       String?
  phone          String?
  isOnboarded    Boolean   @default(false)
  status         String    @default("active") // "active", "trial", "suspended", "cancelled"
  lastActiveAt   DateTime  @default(now())
  logo           String?

  // SEO & Verification
  googleVerificationCode String?
  bingVerificationCode   String?
  yandexVerificationCode String?
  metaExtra              Json?     // Custom meta tags

  users           User[]
  roles           Role[]
  products        Product[]
  integrations    Integration[]
  modules         PurchasedModule[]
  tenantModules   TenantModule[]
  settings        TenantSettings?
  serviceCredentials ServiceCredential[]
  
  competitors     Competitor[]
  priceHistories  PriceHistory[]
  salesForecasts  SalesForecast[]
  orders          Order[]
  supportTickets  SupportTicket[]
  adminTasks      AdminTask[]
  messages        OmnichannelMessage[]
  
  // 2FA & Security
  // (None currently relating to Tenant directly, mostly User)

  // Backup & DR
  backupSchedules BackupSchedule[]
  backupJobs      BackupJob[]
  restoreJobs     RestoreJob[]
  drSettings      DrSettings?

  // Search
  searchHistory   SearchHistory[]
  savedSearches   SavedSearch[]

  // New models
  webhooks        Webhook[]
  automations     Automation[]
  campaigns       Campaign[]
  reviews         Review[]
  stores          Store[]
  payments        Payment[]
  shipments       Shipment[]
  reports         Report[]
  scheduledReports ScheduledReport[]
  apiKeys         ApiKey[]
  bulkActions     BulkAction[]
  seoAnalyses     SeoAnalysis[]
  pricingRules    PricingRule[]
  dashboardLayouts DashboardLayout[]
  returns         Return[]
  priceExperiments PriceExperiment[]
  webhookSecret    String?  // Şifreli, per-tenant webhook imzalama
  
  // AI İçerik Optimizasyonu
  contentAnalyses      ContentAnalysis[]
  contentOptimizations ContentOptimization[]
  contentBatchJobs     ContentBatchJob[]
  contentTemplates     ContentTemplate[]
  contentRules         ContentRule[]

  // Depo Yönetimi
  warehouses           Warehouse[]
  warehouseTransfers   WarehouseTransfer[]

  featureRequests      FeatureRequest[]
}

model TenantSettings {
  id        String @id @default(uuid())
  tenantId  String @unique
  tenant    Tenant @relation(fields: [tenantId], references: [id])
  theme     Json?
  config    Json?
}

model ServiceCredential {
  id           String      @id @default(uuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  serviceType  ServiceType
  label        String?     // Kullanıcının verdiği ad ("Ana iyzico hesabım", "Aras Kurumsal")
  apiUrl       String?     // Şifreli
  apiKey       String?     // Şifreli
  apiSecret    String?     // Şifreli
  apiExtra     Json?       // Ek bilgiler (merchantId, taxNumber vb.)
  isActive     Boolean     @default(true)
  isDefault    Boolean     @default(false) // Bu servis tipi için varsayılan mı?
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([tenantId, serviceType])
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  firstName     String?
  lastName      String?
  phone         String?
  type          UserType @default(USER)
  roleId        String?
  role          Role?    @relation(fields: [roleId], references: [id])
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  dashboardConfig Json?
  permissions   Permission[]
  accounts      Account[]
  sessions      Session[]
  
  assignedTasks AdminTask[] @relation("TaskAssignee")
  createdTasks  AdminTask[] @relation("TaskCreator")

  // 2FA & Security
  twoFactorDevices TwoFactorDevice[]
  backupCodes      BackupCode[]
  temporaryCodes   TemporaryCode[]
  trustedDevices   TrustedDevice[]
  
  // Search
  searchHistory    SearchHistory[]
  savedSearches    SavedSearch[]

  // New relations
  apiKeys          ApiKey[]
  dashboardLayouts DashboardLayout[]
  bulkActions      BulkAction[]
  status           String  @default("active")
  
  featureRequests  FeatureRequest[]
}

model SystemConfig {
  id        String   @id @default("default")
  maintenanceMode Boolean @default(false)
  maintenanceMessage String?
  maintenanceEnd DateTime?
  updatedAt DateTime @updatedAt
}

model Role {
  id          String       @id @default(uuid())
  name        String
  description String?
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions Permission[]
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id        String   @id @default(uuid())
  action    String   // e.g., "product:create"
  resource  String   // e.g., "product"
  roles     Role[]
  // Optional: direct assignment to user override
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
}

model Product {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  title         String
  description   String?
  sku           String
  barcode       String?
  price         Decimal  
  costPrice     Decimal? 
  stock         Int      @default(0)
  category      String?
  brand         String?
  status        String   @default("active") // active, paused, draft
  tags          Json?
  weight        Decimal? 
  
  variants      ProductVariant[]
  images        Image[]
  aiMetadata    Json?    // AI optimized content, SEO keywords, suggestions
  
  marketplaceLinks MarketplaceProduct[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  competitorProducts CompetitorProduct[]
  salesForecasts     SalesForecast[]
  orderItems         OrderItem[]
  inventoryLogs      InventoryLog[]

  // AI İçerik Optimizasyonu
  contentAnalyses      ContentAnalysis[]
  contentOptimizations ContentOptimization[]
  contentBatchItems    ContentBatchItem[]

  @@index([tenantId])
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  sku         String   @unique
  barcode     String?
  price       Decimal  
  costPrice   Decimal?
  stock       Int      @default(0)
  
  // Options (e.g., {"Renk": "Kırmızı", "Beden": "XL"})
  options     Json?
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([sku])
}

model Image {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  url       String
  isMain    Boolean @default(false)
  altText   String?
  processed Boolean @default(false) // If AI processed (background removal etc)
}

model Integration {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  platform    Platform
  apiKey      String
  apiSecret   String
  apiExtra    Json?    // For other keys like merchantId
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketplaceProduct {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  marketplaceListingId String  // ID in the marketplace (e.g., Trendyol product ID)
  platform          Platform
  status            String   // ACTIVE, BLOCKED, etc.
  stock             Int
  price             Decimal  
  lastSyncAt        DateTime @default(now())
}

model PurchasedModule {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  moduleKey String   // e.g., "AI_SEO", "COMPETITOR_ANALYSIS"
  expiresAt DateTime?
  isActive  Boolean  @default(true)
}

model AiJob {
  id          String   @id @default(uuid())
  tenantId    String
  type        String   // SEO_OPTIMIZATION, IMAGE_PROCESSING, etc.
  status      String   // PENDING, PROCESSING, COMPLETED, FAILED
  inputData   Json?
  outputData  Json?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model AiModel {
  id          String   @id @default(uuid())
  name        String   // "GPT-4", "Claude 3", "Gemini Pro" vs
  slug        String   @unique // "gpt-4", "claude-3", etc.
  provider    String   // "openai", "anthropic", "google", "local"
  apiKey      String?  // API anahtarı (şifreli olmalı)
  baseUrl     String?  // Custom endpoint için
  modelId     String   // Provider'ın model ID'si
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0) // Gösterim sırası
  
  // Yetenekler ve özellikler
  capabilities Json?   // { "seo": true, "analysis": true, "image": false }
  config       Json?   // Provider-specific config
  
  // İstatistikler
  tokensUsed   Int     @default(0)
  callsCount   Int     @default(0)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  advisorMessages AdvisorMessage[]
  
  @@index([isActive])
}

model AdvisorMessage {
  id          String   @id @default(uuid())
  aiModelId   String
  aiModel     AiModel  @relation(fields: [aiModelId], references: [id], onDelete: Cascade)
  
  domain      String   // Analiz edilen site
  score       Int      // SEO skoru
  message     String   // AI'nın mesajı
  suggestions Json?    // Yapılandırılmış öneriler
  
  createdAt   DateTime @default(now())
}

// ==================== MARKET INTELLIGENCE (Faz 1) ====================

model Competitor {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  platform    Platform
  storeUrl    String?
  logoUrl     String?
  rating      Decimal? 
  reviewCount Int      @default(0)
  isActive    Boolean  @default(true)
  
  products    CompetitorProduct[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([platform])
}

model CompetitorProduct {
  id              String   @id @default(uuid())
  competitorId    String
  competitor      Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  productId       String?  // Our related product (if mapped)
  product         Product? @relation(fields: [productId], references: [id])
  
  marketplaceId   String   // ID in the marketplace
  url             String?
  title           String
  price           Decimal  
  stock           Int?
  rating          Decimal? 
  reviewCount     Int      @default(0)
  
  priceHistory    PriceHistory[]
  
  lastCheckedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([competitorId])
  @@index([productId])
  @@index([marketplaceId])
}

model PriceHistory {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  productId           String?  // Our product
  competitorProductId String?  // Or competitor's product
  
  price               Decimal  
  platform            Platform
  
  competitorProduct   CompetitorProduct? @relation(fields: [competitorProductId], references: [id])
  
  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([competitorProductId])
  @@index([createdAt])
}

model SalesForecast {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  forecastDate    DateTime
  predictedSales  Int
  confidenceScore Decimal   // 0.00 to 1.00
  
  metadata        Json?    // Factors considered (seasonal, trend, etc.)
  
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([forecastDate])
}

model CmsPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String  
  category  String   // e.g., "urun", "sirket", "kaynaklar", "yasal"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([slug])
  @@index([category])
}

// ==================== FINANCE & OMNICHANNEL (Faz 3) ====================

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  
  platform        Platform
  marketplaceOrderId String   // ID in the marketplace
  
  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  shippingAddress String?
  billingAddress  String?
  
  totalAmount     Decimal  
  taxAmount       Decimal  
  shippingCost    Decimal   @default(0)
  commissionAmount Decimal  @default(0)
  netProfit       Decimal   @default(0)
  currency        String   @default("TRY")
  
  trackingNumber  String?
  shippingProvider String?
  notes           String? 
  
  items           OrderItem[]
  invoice         Invoice?
  supportTickets  SupportTicket[]
  
  orderDate       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([platform])
  @@index([status])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  
  sku             String
  title           String
  quantity        Int
  unitPrice       Decimal  
  taxRate         Decimal   // e.g., 20.00
  discountAmount  Decimal   @default(0)
  
  createdAt       DateTime @default(now())
}

// ─── İade Yönetimi (RMA) ────────────────────────────────
model Return {
  id              String       @id @default(uuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  
  orderId         String
  platform        Platform
  
  customerName    String
  customerEmail   String?
  customerPhone   String?
  
  status          ReturnStatus @default(PENDING)
  reason          ReturnReason
  reasonDetail    String?     
  
  items           ReturnItem[]
  
  refundAmount    Decimal       @default(0)
  shippingCost    Decimal       @default(0)
  restockFee      Decimal       @default(0)
  refundMethod    String?      // original_payment, store_credit, bank_transfer
  
  trackingNumber  String?
  notes           String?     
  resolution      String?      // refund, replacement, repair, rejected
  
  requestDate     DateTime     @default(now())
  resolvedDate    DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@index([status])
  @@index([orderId])
}

model ReturnItem {
  id          String  @id @default(uuid())
  returnId    String
  returnReq   Return  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  
  sku         String
  title       String
  quantity    Int
  unitPrice   Decimal 
  condition   String? // unopened, opened, damaged, defective
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  SHIPPED
  RECEIVED
  INSPECTING
  REFUNDED
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  DAMAGED_IN_SHIPPING
  LATE_DELIVERY
  DUPLICATE_ORDER
  OTHER
}

model MarketplaceCommission {
  id              String   @id @default(uuid())
  platform        Platform
  category        String?
  commissionRate  Decimal   // e.g., 15.50 for 15.5%
  fixedFee        Decimal   @default(0)
  lastUpdated     DateTime @default(now())
  
  @@unique([platform, category])
}

model Invoice {
  id              String   @id @default(uuid())
  tenantId        String?
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  
  invoiceNumber   String   @unique
  invoiceDate     DateTime @default(now())
  
  // E-Fatura alanları
  type            String   @default("SATIS") // SATIS, IADE, ISTISNA, OZELMATRAH, IHRACKAYITLI, TEVKIFAT
  scenario        String   @default("TEMEL")  // TEMEL, TICARI, IHRACAT, YOLCU_BERABER 
  
  // Alıcı bilgileri
  buyerTitle      String?
  buyerTaxNumber  String?
  buyerTaxOffice  String?
  buyerAddress    String?
  buyerCity       String?
  buyerDistrict   String?
  buyerEmail      String?
  
  // Satıcı bilgileri (tenant'dan çekilir ama burada da saklanır)
  sellerTitle     String?
  sellerTaxNumber String?
  sellerTaxOffice String?
  
  // Tutar bilgileri
  subtotal        Decimal?
  taxAmount       Decimal?
  totalAmount     Decimal?
  currency        String   @default("TRY")
  
  // Kalem detayları
  items           Json?    // E-fatura kalemleri
  
  // E-fatura durumu
  status          String   @default("DRAFT") // DRAFT, PENDING, SENT, ACCEPTED, REJECTED, CANCELLED
  
  // GIB bilgileri
  gibInvoiceId    String?  // GIB UUID
  gibEnvelopeId   String?  // GIB zarf ID
  gibStatusCode   String?
  gibStatusDesc   String?
  
  url             String?  // PDF link
  xmlUrl          String?  // UBL-TR XML link
  
  sentAt          DateTime?
  acceptedAt      DateTime?
  
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([tenantId])
  @@index([status])
  @@index([gibInvoiceId])
}

model InventoryLog {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  
  change          Int      // e.g., -1 for sale, +10 for restock
  type            String   // SALE, RESTOCK, RETURN, ADJUSTMENT
  description     String?
  previousStock   Int      @default(0)
  newStock        Int      @default(0)
  note            String?
  
  createdAt       DateTime @default(now())
  
  @@index([productId])
}

// ==================== CUSTOMER SUPPORT & AI CRM (Faz 5) ====================

model SupportTicket {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  marketplaceId String?  // ID in the marketplace if applicable
  platform      Platform
  subject       String
  status        String   @default("OPEN") // OPEN, PENDING, RESOLVED, CLOSED
  priority      String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id])
  
  customerName  String?
  customerEmail String?
  
  messages      OmnichannelMessage[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([platform])
  @@index([status])
}

model OmnichannelMessage {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  content         String  
  senderType      String   // CUSTOMER, SYSTEM, AGENT
  platformMessageId String? // ID in the marketplace
  isRead          Boolean  @default(false)
  
  aiSuggestion    String?  // AI generated response draft
  
  createdAt       DateTime @default(now())

  @@index([tenantId])
  @@index([ticketId])
}

// ==================== MODÜLER SİSTEM ====================

enum ModuleCategory {
  AI_TOOLS
  ANALYTICS
  MARKETPLACE
  FINANCE
  MARKETING
  LOGISTICS
  AUTOMATION
  REPORTS
}

enum AnnouncementType {
  INFO
  WARNING
  SUCCESS
  PROMOTION
  MAINTENANCE
  UPDATE
}

enum AnnouncementTarget {
  ALL
  FREE_USERS
  PRO_USERS
  ENTERPRISE_USERS
  SPECIFIC_TENANTS
}

model SystemModule {
  id            String         @id @default(uuid())
  key           String         @unique // Örn: "AI_SEO", "COMPETITOR_ANALYSIS"
  name          String         // Görünen isim
  description   String?       
  icon          String?        // Lucide icon ismi
  category      ModuleCategory
  
  // Fiyatlandırma
  basePrice     Decimal         @default(0)
  monthlyPrice  Decimal         @default(0)
  yearlyPrice   Decimal?       
  
  // Plan kısıtlamaları
  requiredPlan  Plan           @default(FREE)
  isCore        Boolean        @default(false) // Temel modül mü (kaldırılamaz)
  isActive      Boolean        @default(true)
  isBeta        Boolean        @default(false)
  isNew         Boolean        @default(false)
  
  // Özellikler ve yapılandırma
  features      Json?          // Modül özellikleri listesi
  config        Json?          // Varsayılan yapılandırma
  permissions   Json?          // Gerekli izinler
  dependencies  Json?       // Bağımlı modül keyleri
  
  // İstatistikler
  usageCount    Int            @default(0)
  rating        Decimal?       
  
  // Sıralama ve görünüm
  sortOrder     Int            @default(0)
  showInMenu    Boolean        @default(true)
  menuPath      String?        // "/dashboard/ai-tools" gibi
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  tenantModules TenantModule[]
  
  @@index([category])
  @@index([isActive])
  @@index([requiredPlan])
}

model TenantModule {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  moduleId      String
  module        SystemModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  isEnabled     Boolean      @default(true)
  customConfig  Json?        // Tenant'a özel yapılandırma
  
  // Abonelik bilgileri
  startDate     DateTime     @default(now())
  endDate       DateTime?
  isTrial       Boolean      @default(false)
  trialEndsAt   DateTime?
  
  // Kullanım istatistikleri
  lastUsedAt    DateTime?
  usageCount    Int          @default(0)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@unique([tenantId, moduleId])
  @@index([tenantId])
  @@index([moduleId])
}

// ==================== DUYURU SİSTEMİ ====================

model Announcement {
  id            String             @id @default(uuid())
  title         String
  content       String            
  summary       String?            // Kısa özet
  
  type          AnnouncementType   @default(INFO)
  target        AnnouncementTarget @default(ALL)
  targetTenants Json?           // SPECIFIC_TENANTS için tenant ID'leri
  
  // Görünüm
  icon          String?
  color         String?            // Tailwind renk sınıfı
  imageUrl      String?
  actionUrl     String?            // CTA butonu için URL
  actionText    String?            // CTA buton metni
  
  // Zamanlama
  startsAt      DateTime           @default(now())
  endsAt        DateTime?
  
  // Durum
  isActive      Boolean            @default(true)
  isPinned      Boolean            @default(false)
  priority      Int                @default(0)
  
  // Meta
  viewCount     Int                @default(0)
  dismissCount  Int                @default(0)
  
  createdBy     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  reads         AnnouncementRead[]
  
  @@index([isActive, startsAt])
  @@index([type])
  @@index([target])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  tenantId       String
  userId         String?
  
  isRead         Boolean      @default(true)
  isDismissed    Boolean      @default(false)
  readAt         DateTime     @default(now())
  
  @@unique([announcementId, tenantId])
  @@index([tenantId])
}

// ==================== SİSTEM AYARLARI ====================

model SystemSettings {
  id            String   @id @default(uuid())
  key           String   @unique
  value         Json
  category      String   // "general", "email", "payment", "notification"
  description   String?
  isPublic      Boolean  @default(false) // Frontend'e gösterilsin mi
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([category])
}

// ==================== AKTİVİTE VE AUDIT LOG ====================

model ActivityLog {
  id          String   @id @default(uuid())
  tenantId    String?
  userId      String?
  
  action      String   // "module.enabled", "settings.updated", etc.
  resource    String   // "module", "product", "order"
  resourceId  String?
  
  details     Json?
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
  
  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ==================== ÖNERİ SİSTEMİ ====================

model FeatureRequest {
  id          String   @id @default(uuid())
  tenantId    String?
  userId      String?
  
  title       String
  description String  
  category    String   // "feature", "improvement", "bug"
  status      String   @default("pending") // "pending", "reviewing", "planned", "completed", "rejected"
  
  votes       Int      @default(0)
  priority    Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  user        User?    @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([category])
}

// ==================== KANBAN TASK MANAGER (Faz 3) ====================

model AdminTask {
  id          String   @id @default(uuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  
  title       String
  description String?  
  status      String   @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, DONE
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  
  creatorId   String?
  creator     User?    @relation("TaskCreator", fields: [creatorId], references: [id])
  
  dueDate     DateTime?
  tags        Json?    // ["frontend", "bug"]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId])
  @@index([status])
  @@index([assigneeId])
}

// ==================== NEXT AUTH ====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  title     String?
  content   String
  rating    Int      @default(5)
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}
// ==================== 2FA & SECURITY ====================

model TwoFactorDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  secret    String?  // Made optional for SMS/Email
  type      String   @default("TOTP") // TOTP, SMS, EMAIL
  phoneNumber String?
  isDefault Boolean  @default(false)
  verified  Boolean  @default(false)
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BackupCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   // Hashed usually
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TemporaryCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  type      String   // LOGIN, PASSWORD_RESET
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TrustedDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String?
  deviceHash String
  userAgent String?
  ipAddress String?
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime?
}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  ipAddress String?
  userAgent String?
  isSuccess Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==================== BACKUP & DISASTER RECOVERY ====================

model BackupSchedule {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String?
  type      String   @default("FULL")
  frequency String   // hourly, daily, weekly
  cronExpression String?
  retentionDays Int      @default(7)
  databases Json?
  isActive  Boolean  @default(true)
  nextRunAt DateTime?
  failureCount Int     @default(0)
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BackupJob {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String?
  type      String
  status    String   // PENDING, SUCCESS, FAILED
  compressedSize Int?
  uncompressedSize Int?
  compressionRatio Decimal? 
  location  String?
  storageType String?
  databases Json?
  tables    Int?
  rows      Int?
  url       String?
  error     String?
  duration  Int?
  verificationStatus String?
  retentionDays Int?
  expiresAt DateTime?
  estimatedRestoreTimeMs Int?
  startTime DateTime @default(now())
  endTime   DateTime?
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestoreJob {
