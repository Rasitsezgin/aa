model ForumCustomFieldValue {
  id          String   @id @default(uuid())
  
  fieldId     String
  field       ForumCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  value       String   @db.Text
  
  @@unique([fieldId, userId])
