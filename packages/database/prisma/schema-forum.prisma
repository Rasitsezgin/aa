  postId      String?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

model ForumLevelReward {
  id          String   @id @default(uuid())
  level       Int      @unique
  title       String
  description String?
  
  // Rewards
  badgeId     String?  // Optional badge given
  groupId     String?  // Group upgrade
  permissions Json?    // Extra permissions
  
  // Display
  icon        String?
  color       String   @default("gold")
  
  createdAt   DateTime @default(now())
}

// ==================== DAILY QUESTS & MISSIONS ====================

model ForumDailyQuest {
  id          String   @id @default(uuid())
  
  // Quest details
  title       String
  description String?
  type        String   // daily, weekly, special
  
  // Requirements
