// ==================== TRUST SYSTEM (Discourse-style) ====================

model ForumTrustLevel {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Trust levels: 0 (new), 1 (basic), 2 (member), 3 (regular), 4 (leader)
  level       Int      @default(0)
  
  // Requirements tracking
