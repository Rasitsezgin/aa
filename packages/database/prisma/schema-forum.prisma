  itemId      String
  item        ForumStoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  price       Int      // Price at time of purchase
  
  isGift      Boolean  @default(false)
  giftToId    String?  // If gifted to another user
  
  isUsed      Boolean  @default(false)
  usedAt      DateTime?
  
