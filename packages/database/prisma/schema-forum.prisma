  userId      String   @unique
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  balance     Int      @default(0)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  
  transactions ForumCreditTransaction[]
  
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model ForumCreditTransaction {
  id          String   @id @default(uuid())
  
  userId      String
  user        ForumUserCredit @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount      Int      // Positive = credit, Negative = debit
  type        String   // earn_post, earn_quest, earn_daily, earn_login, spend_store, gift_sent, gift_received, admin_grant, admin_deduct
  
  description String?
  
  relatedId   String?  // postId, questId, purchaseId, etc.
  
  balanceAfter Int
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

// ==================== VOICE MESSAGES ====================

model ForumVoiceMessage {
  id          String   @id @default(uuid())
  
  // Parent content
