  timeSpentMins   Int      @default(0)
  
  likesGiven      Int      @default(0)
  likesReceived   Int      @default(0)
  
  flagsGiven      Int      @default(0)
  flagsAccepted   Int      @default(0)
  
  // Manual lock
  lockedAtLevel   Int?     // Admin can lock at specific level
  lockedBy        String?
  lockedReason    String?
  
  promotedAt      DateTime[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
