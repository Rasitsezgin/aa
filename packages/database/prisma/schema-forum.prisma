// ==================== FORUM SYSTEM (vBulletin/XenForo Style) ====================

enum ForumUserRole {
  MEMBER
  MODERATOR
  SUPER_MODERATOR
  ADMIN
}

model ForumUserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Forum Stats
  postCount       Int      @default(0)
  topicCount      Int      @default(0)
  reputation      Int      @default(0)
  helpfulCount    Int      @default(0)
  thanksReceived  Int      @default(0)
  thanksGiven     Int      @default(0)
  
  // User Groups
  primaryGroupId  String?
  primaryGroup    ForumUserGroup? @relation("PrimaryGroup", fields: [primaryGroupId], references: [id])
  secondaryGroups ForumUserGroup[] @relation("SecondaryGroups")
  
  // Customization
  signature       String?  @db.Text
  avatarUrl       String?
  coverImageUrl   String?
  location        String?
  occupation      String?
  website         String?
  about           String?  @db.Text
  
  // Status
  isOnline        Boolean  @default(false)
  lastActivityAt  DateTime @default(now())
  lastPostAt      DateTime?
  joinedAt        DateTime @default(now())
  
  // Preferences
  showSignatures  Boolean  @default(true)
  showAvatars     Boolean  @default(true)
  emailNotifications Boolean @default(true)
  
  // Punishments
  isBanned        Boolean  @default(false)
  banReason       String?
  banExpiresAt    DateTime?
  warnPoints      Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  posts           ForumPost[]
  topics          ForumTopic[]
  reactions       ForumReaction[]
  privateMessages ForumPrivateMessage[] @relation("MessageAuthor")
  conversations   ForumConversationParticipant[]
  badges          ForumUserBadge[]
  achievements    ForumUserAchievement[]
  subscriptions   ForumSubscription[]
  watchedTopics   ForumTopicWatch[]
  reports         ForumReport[] @relation("ReportReporter")
  warnedReports   ForumReport[] @relation("ReportWarnedUser")
  
  // Gamification Relations
  userLevel       ForumUserLevel?
  xpLogs          ForumXpLog[]
  questProgress   ForumUserQuest[]
  leaderboardEntries ForumLeaderboardEntry[]
  
  // Notification Relations
  notifications   ForumNotification[]
  notificationPrefs ForumNotificationPreference?
  
  // Wiki Relations
  wikiEdits       ForumWiki[]
  wikiVersions    ForumWikiVersion[]
  
  // Event Relations
  eventAttendees  ForumEventAttendee[]
  
  // Webhook Relations
  webhookLogs     ForumWebhookLog[]
  
  // Auto-save Relations
  autoSaves       ForumAutoSave[]
  
  // Tip Relations
  tipsSent        ForumUserTip[] @relation("TipSender")
  tipsReceived    ForumUserTip[] @relation("TipReceiver")
  
  // Friendship Relations
  friendshipsSent ForumFriendship[] @relation("FriendshipRequester")
  friendshipsReceived ForumFriendship[] @relation("FriendshipAddressee")
  
  // Read Time Relations
  readTimes       ForumReadTime[]
  
  // IP Log Relations
  ipLogs          ForumIpLog[]
  
  // Custom Field Relations
  customFieldValues ForumCustomFieldValue[]
  
  // Activity Relations
  activities      ForumActivity[]
  
  // Trust Level Relations
  trustLevel      ForumTrustLevel?
  
  // AI Relations
  aiSummaries     ForumAiSummary[]
  aiTranslations  ForumAiTranslation[]
  aiToxicityChecks ForumAiToxicity[]
  aiDuplicates    ForumAiDuplicate[]
  aiSmartReplies  ForumAiSmartReply[]
  
  // Real-time Relations
  typingIndicators ForumTypingIndicator[]
  websocketSessions ForumWebSocketSession[]
  
  // Live Stream Relations
  liveStreams     ForumLiveStream[]
  streamViewers   ForumLiveStreamViewer[]
  
  // NFT Relations
  nftAvatars      ForumNftAvatar[]
  
  // Theme Relations
  createdThemes   ForumCustomTheme[]
  userTheme       ForumUserTheme?
  
  // Push Notification Relations
  pushSubscriptions ForumPushSubscription[]
  pwaInstalls     ForumPwaInstall[]
  
  // Emoji Relations
  emojiReactions  ForumEmojiReaction[]
  customEmojis    ForumCustomEmoji[]
  
  // GIF Relations
  gifUsages       ForumGifUsage[]
  
  // Language Relations
  languagePrefs   ForumUserLanguage?
  
  // Screen Share Relations
  screenShares    ForumScreenShare[]
  screenShareViewers ForumScreenShareViewer[]
  
  // Search Relations
  savedSearches   ForumSavedSearch[]
  
  // Bulk Action Relations
  bulkActions     ForumBulkAction[]
  
  // Data Export Relations
  dataExports     ForumDataExport[]
  dataDeletions   ForumDataDeletion[]
  
  // Store Relations
  storePurchases  ForumStorePurchase[]
  userCredits     ForumUserCredit?
  creditTransactions ForumCreditTransaction[]
  
  // Voice Message Relations
  voiceMessages   ForumVoiceMessage[]
  
  // Live Chat Relations
  chatMessages    ForumLiveChatMessage[]
  
  // Tournament Relations
  tournamentParticipants ForumTournamentParticipant[]
  
  // Subscription Relations
  userSubscriptions ForumUserSubscription?
  
  // Recommendation Relations
  recommendations ForumRecommendation[]
  
  // Block Relations
  blockedUsers    ForumUserBlock[] @relation("Blocker")
  blockedByUsers  ForumUserBlock[] @relation("Blocked")
  
  // Heatmap Relations (for analytics tracking)
  @@index([userId])
  @@index([primaryGroupId])
  @@index([isBanned])
  @@index([postCount])
  @@index([reputation])
}

model ForumUserGroup {
  id              String   @id @default(uuid())
  name            String   @unique
  title           String
  color           String   @default("#6366f1")
  icon            String?
  
  // Permissions (JSON for flexibility)
  permissions     Json     // { canCreateTopic: true, canEditOthers: false, ... }
  
  // Display
  isStaff         Boolean  @default(false)
  isModerator     Boolean  @default(false)
  isAdmin         Boolean  @default(false)
  displayOrder    Int      @default(0)
  
  // Relations
  primaryUsers    ForumUserProfile[] @relation("PrimaryGroup")
  secondaryUsers  ForumUserProfile[] @relation("SecondaryGroups")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([name])
  @@index([isStaff])
}

// ==================== FORUM CATEGORIES & BOARDS ====================

model ForumCategory {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?
  icon            String?
  color           String?  @default("blue")
  
  // Display
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  isPrivate       Boolean  @default(false)
  
  // Permissions
  viewPermission  String?  // user group id or null for all
  postPermission  String?
  
  // Relations
  boards          ForumBoard[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([slug])
  @@index([displayOrder])
  @@index([isActive])
}

enum ForumBoardType {
  CATEGORY    // Contains sub-boards
  FORUM       // Normal discussion forum
  LINK        // Redirect to external URL
  QNA         // Question & Answer format
  POLL        // Poll/Survey board
  ANNOUNCEMENT // Admin-only posts
}

model ForumBoard {
  id              String   @id @default(uuid())
  categoryId      String?
  category        ForumCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  parentId        String?
  parent          ForumBoard? @relation("BoardChildren", fields: [parentId], references: [id])
  children        ForumBoard[] @relation("BoardChildren")
  
  name            String
  slug            String   @unique
  description     String?
  type            ForumBoardType @default(FORUM)
  
  // Display
  icon            String?
  color           String?  @default("slate")
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  
  // Link type
  externalUrl     String?
  
  // Stats (denormalized for performance)
  topicCount      Int      @default(0)
  postCount       Int      @default(0)
  lastTopicId     String?
  lastTopicTitle  String?
  lastPostId      String?
  lastPostAt      DateTime?
  lastPosterId    String?
  lastPosterName  String?
  
  // Settings
  allowPolls      Boolean  @default(true)
  allowAttachments Boolean  @default(true)
  requireApproval Boolean  @default(false)
  topicsPerPage   Int      @default(25)
  postsPerPage    Int      @default(20)
  
  // Moderation
  moderators      ForumBoardModerator[]
  
  // Relations
  topics          ForumTopic[]
  subscriptions   ForumSubscription[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([slug])
  @@index([categoryId])
  @@index([parentId])
  @@index([displayOrder])
  @@index([isActive])
  @@index([lastPostAt])
}

model ForumBoardModerator {
  id          String   @id @default(uuid())
  boardId     String
  board       ForumBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Moderator permissions
  canEdit     Boolean  @default(true)
  canDelete   Boolean  @default(true)
  canSticky   Boolean  @default(true)
  canClose    Boolean  @default(true)
  canMove     Boolean  @default(true)
  canMerge    Boolean  @default(true)
  canBan      Boolean  @default(false)
  canWarn     Boolean  @default(true)
  
  addedBy     String
  addedAt     DateTime @default(now())
  
  @@unique([boardId, userId])
  @@index([userId])
}

// ==================== TOPICS & POSTS ====================

enum ForumTopicType {
  NORMAL
  STICKY      // Pinned to top
  ANNOUNCEMENT // Important announcement
  GLOBAL      // Show on all boards
  POLL        // Has poll
  QNA         // Question/Answer
}

enum ForumTopicStatus {
  OPEN
  CLOSED      // No new replies
  SOLVED      // Q&A solved
  ARCHIVED    // Old topic
  DELETED     // Soft delete
}

model ForumTopic {
  id              String   @id @default(uuid())
  boardId         String
  board           ForumBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  
  authorId        String
  author          ForumUserProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  title           String
  slug            String   @unique
  
  // Type & Status
  type            ForumTopicType @default(NORMAL)
  status          ForumTopicStatus @default(OPEN)
  
  // Content (first post is stored separately for performance)
  firstPostId     String?
  firstPost       ForumPost? @relation("TopicFirstPost")
  
  // Stats
  viewCount       Int      @default(0)
  replyCount      Int      @default(0)
  
  // Reactions on topic
  reactionCount   Int      @default(0)
  
  // Poll
  hasPoll         Boolean  @default(false)
  poll            ForumPoll?
  
  // Q&A
  bestAnswerId    String?
  bestAnswer      ForumPost? @relation("BestAnswer")
  
  // Important dates
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bumpedAt        DateTime @default(now()) // For sorting
  lastPostAt      DateTime @default(now())
  
  // Relations
  posts           ForumPost[]
  reactions       ForumTopicReaction[]
  watchers        ForumTopicWatch[]
  tags            ForumTopicTag[]
  
  // AI Relations
  aiSummaries     ForumAiSummary[]
  aiDuplicates    ForumAiDuplicate[]
  aiSmartReplies  ForumAiSmartReply[]
  
  // Lifecycle
  lifecycle       ForumTopicLifecycle?
  
  // Trend Predictions
  trendPredictions ForumTrendPrediction[]
  
  // Recommendations
  recommendations ForumRecommendation[]
  
  // Notifications
  notifications   ForumNotification[]
  
  // Read Time
  readTimes       ForumReadTime[]
  
  // Emoji Reactions
  emojiReactions  ForumEmojiReaction[]
  
  // Similar topics (duplicate detection)
  similarTo       ForumAiDuplicate[] @relation("SimilarTopic")
  
  @@index([boardId])
  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([bumpedAt])
  @@index([lastPostAt])
}

model ForumTopicTag {
  id          String   @id @default(uuid())
  topicId     String
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  name        String
  slug        String
  color       String?  @default("gray")
  
  @@unique([topicId, slug])
  @@index([slug])
}

model ForumPost {
  id              String   @id @default(uuid())
  topicId         String
  topic           ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  authorId        String
  author          ForumUserProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  // Content
  content         String   @db.Text
  contentHtml     String   @db.Text // Processed HTML
  
  // Editor info
  editorType      String   @default("wysiwyg") // wysiwyg, markdown, bbcode
  
  // Post number in topic
  postNumber      Int
  
  // Reply to
  replyToId       String?
  replyTo         ForumPost? @relation("PostReplies", fields: [replyToId], references: [id])
  replies         ForumPost[] @relation("PostReplies")
  
  // Edits
  editCount       Int      @default(0)
  lastEditAt      DateTime?
  lastEditReason  String?
  editHistory     ForumPostEdit[]
  
  // Reactions
  reactionCount   Int      @default(0)
  reactions       ForumReaction[]
  
  // Attachments
  attachments     ForumAttachment[]
  
  // Status
  isDeleted       Boolean  @default(false)
  isHidden        Boolean  @default(false)
  isApproved      Boolean  @default(true)
  deletedAt       DateTime?
  deletedBy       String?
  deletedReason   String?
  
  // Reports
  reports         ForumReport[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Inverse relations
  isFirstPostOf   ForumTopic? @relation("TopicFirstPost")
  isBestAnswerOf  ForumTopic? @relation("BestAnswer")
  
  // AI Relations
  aiSummaries     ForumAiSummary[]
  aiTranslations  ForumAiTranslation[]
  
  // Emoji Relations
  emojiReactions  ForumEmojiReaction[]
  
  // Voice Message Relations
  voiceMessages   ForumVoiceMessage[]
  
  // GIF Relations
  gifUsages       ForumGifUsage[]
  
  // Read Time Relations
  readTimes       ForumReadTime[]
  
  @@index([topicId])
  @@index([authorId])
  @@index([createdAt])
  @@index([postNumber])
}

model ForumPostEdit {
  id          String   @id @default(uuid())
  postId      String
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  oldContent  String   @db.Text
  newContent  String   @db.Text
  reason      String?
  editedBy    String
  editedAt    DateTime @default(now())
  
  @@index([postId])
}

// ==================== POLLS ====================

model ForumPoll {
  id              String   @id @default(uuid())
  topicId         String   @unique
  topic           ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  question        String
  
  // Settings
  isMultiple      Boolean  @default(false)
  maxChoices      Int      @default(1)
  isPublic        Boolean  @default(false) // Show who voted
  hasEndDate      Boolean  @default(false)
  endAt           DateTime?
  
  // Options
  options         ForumPollOption[]
  
  // Stats
  voteCount       Int      @default(0)
  voterCount      Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([topicId])
}

model ForumPollOption {
  id          String   @id @default(uuid())
  pollId      String
  poll        ForumPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  
  text        String
  position    Int
  voteCount   Int      @default(0)
  
  // Voters (if public)
  voters      ForumPollVote[]
  
  @@index([pollId])
}

model ForumPollVote {
  id          String   @id @default(uuid())
  pollId      String
  poll        ForumPoll @relation(fields: [pollId], references: [id])
  
  optionId    String
  option      ForumPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  votedAt     DateTime @default(now())
  
  @@unique([pollId, userId])
  @@index([optionId])
}

// ==================== REACTIONS ====================

enum ForumReactionType {
  LIKE
  THANKS
  HELPFUL
  AGREE
  FUNNY
  INSIGHTFUL
  LOVE
}

model ForumReaction {
  id          String   @id @default(uuid())
  postId      String
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        ForumReactionType
  
  createdAt   DateTime @default(now())
  
  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model ForumTopicReaction {
  id          String   @id @default(uuid())
  topicId     String
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        ForumReactionType
  
  createdAt   DateTime @default(now())
  
  @@unique([topicId, userId])
}

// ==================== ATTACHMENTS ====================

model ForumAttachment {
  id          String   @id @default(uuid())
  postId      String?
  post        ForumPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  
  uploaderId  String
  uploader    ForumUserProfile @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  
  // File info
  filename    String
  originalName String
  mimeType    String
  size        Int
  url         String
  
  // Image specific
  width       Int?
  height      Int?
  thumbnailUrl String?
  
  // Status
  isImage     Boolean  @default(false)
  downloads   Int      @default(0)
  
  createdAt   DateTime @default(now())
  
  @@index([postId])
  @@index([uploaderId])
}

// ==================== PRIVATE MESSAGES ====================

model ForumConversation {
  id          String   @id @default(uuid())
  
  // For group conversations
  title       String?
  isGroup     Boolean  @default(false)
  
  // Creator
  creatorId   String
  creator     ForumUserProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  
  // Participants
  participants ForumConversationParticipant[]
  
  // Messages
  messages    ForumPrivateMessage[]
  
  // Stats
  messageCount Int     @default(0)
  
  // Last message
  lastMessageAt DateTime @default(now())
  lastMessageId String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([creatorId])
  @@index([lastMessageAt])
}

model ForumConversationParticipant {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    ForumConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  userId          String
  user            ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Settings
  isAdmin         Boolean  @default(false) // For group conversations
  
  // Read status
  lastReadAt      DateTime @default(now())
  unreadCount     Int      @default(0)
  
  // Notifications
  isMuted         Boolean  @default(false)
  
  // Left conversation
  hasLeft         Boolean  @default(false)
  leftAt          DateTime?
  
  @@unique([conversationId, userId])
  @@index([userId])
}

model ForumPrivateMessage {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    ForumConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  authorId        String
  author          ForumUserProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  content         String   @db.Text
  contentHtml     String   @db.Text
  
  // Edit
  isEdited        Boolean  @default(false)
  editedAt        DateTime?
  
  // Status
  isDeleted       Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  
  @@index([conversationId])
  @@index([authorId])
}

// ==================== BADGES & ACHIEVEMENTS ====================

model ForumBadge {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String
  color       String   @default("gold")
  
  // Requirements to earn
  requirementType String? // posts, reputation, thanks, days_registered, etc.
  requirementValue Int?
  
  // Display
  isHidden    Boolean  @default(false) // Secret badge
  displayOrder Int     @default(0)
  
  // Relations
  users       ForumUserBadge[]
  
  createdAt   DateTime @default(now())
  
  @@index([name])
}

model ForumUserBadge {
  id          String   @id @default(uuid())
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  badgeId     String
  badge       ForumBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  
  // Display
  isDisplayed Boolean  @default(true)
  displayOrder Int     @default(0)
  
  earnedAt    DateTime @default(now())
  
  @@unique([userId, badgeId])
  @@index([badgeId])
}

model ForumAchievement {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String
  points      Int      @default(0)
  
  // Category
  category    String   @default("general")
  
  // Requirements
  requirements Json    // { action: "post_created", count: 10 }
  
  createdAt   DateTime @default(now())
}

model ForumUserAchievement {
  id              String   @id @default(uuid())
  userId          String
  user            ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  achievementId   String
  achievement     ForumAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  progress        Int      @default(0)
  isCompleted     Boolean  @default(false)
  completedAt     DateTime?
  
  @@unique([userId, achievementId])
  @@index([achievementId])
}

// ==================== SUBSCRIPTIONS & WATCHING ====================

enum ForumSubscriptionType {
  INSTANT
  DAILY
  WEEKLY
  NONE
}

model ForumSubscription {
  id              String   @id @default(uuid())
  userId          String
  user            ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Can subscribe to board or category
  boardId         String?
  board           ForumBoard? @relation(fields: [boardId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        ForumCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  notificationType ForumSubscriptionType @default(INSTANT)
  
  createdAt       DateTime @default(now())
  
  @@unique([userId, boardId])
  @@unique([userId, categoryId])
}

model ForumTopicWatch {
  id          String   @id @default(uuid())
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  topicId     String
  topic       ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  // Notification
  notifyReplies Boolean  @default(true)
  
  // Read tracking
  lastReadPostId String?
  lastReadAt    DateTime @default(now())
  
  createdAt     DateTime @default(now())
  
  @@unique([userId, topicId])
  @@index([topicId])
}

// ==================== MODERATION & REPORTS ====================

enum ForumReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ForumReportReason {
  SPAM
  OFFENSIVE
  HARASSMENT
  OFF_TOPIC
  DUPLICATE
  OTHER
}

model ForumReport {
  id          String   @id @default(uuid())
  
  reporterId  String
  reporter    ForumUserProfile @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  
  // Reported content
  postId      String?
  post        ForumPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  topicId     String?
  topic       ForumTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  userId      String?
  user        ForumUserProfile? @relation("ReportWarnedUser", fields: [userId], references: [id], onDelete: Cascade)
  
  reason      ForumReportReason
  description String?
  
  // Status
  status      ForumReportStatus @default(PENDING)
  
  // Moderator action
  moderatorId String?
  moderatorNote String?
  resolvedAt  DateTime?
  
  // Action taken
  actionTaken String?  // warning, ban, delete, dismiss
  warnPoints  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([status])
  @@index([reporterId])
  @@index([postId])
