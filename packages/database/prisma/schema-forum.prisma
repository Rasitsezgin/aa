// ==================== NOTIFICATIONS SYSTEM ====================

enum ForumNotificationType {
  REPLY
  QUOTE
  MENTION
  REACTION
  BEST_ANSWER
  FOLLOW
  MESSAGE
  SYSTEM
  ACHIEVEMENT
  LEVEL_UP
  WARN
  BAN
}

model ForumNotification {
  id          String   @id @default(uuid())
  
  // Recipient
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Type & Content
  type        ForumNotificationType
  title       String
  message     String?
  
  // Related content
  actorId     String?  // Who triggered
  postId      String?
  topicId     String?
  topic       ForumTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  // Status
  isRead      Boolean  @default(false)
  readAt      DateTime?
  
  // Action URL
  actionUrl   String?
  
  // Grouping (for batch notifications)
  batchId     String?
  batchCount  Int      @default(1)
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

model ForumNotificationPreference {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Email notifications
  emailOnReply        Boolean  @default(true)
  emailOnQuote        Boolean  @default(true)
  emailOnMention      Boolean  @default(true)
  emailOnReaction     Boolean  @default(false)
  emailOnMessage      Boolean  @default(true)
  emailOnAchievement  Boolean  @default(true)
  emailDigest         String   @default("never") // never, daily, weekly
  
  // Push notifications
  pushEnabled         Boolean  @default(true)
  pushOnReply         Boolean  @default(true)
  pushOnMention       Boolean  @default(true)
  pushOnMessage       Boolean  @default(true)
  
  // Sound
  soundEnabled        Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== WIKI / KNOWLEDGE BASE ====================

model ForumWiki {
  id          String   @id @default(uuid())
  
  // Page info
  slug        String   @unique
  title       String
  content     String   @db.Text
  contentHtml String   @db.Text
  
  // Category
