  @@index([moderatorId])
  @@index([createdAt])
}

// ==================== GAMIFICATION - LEVELS & XP ====================

model ForumUserLevel {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Level info
