  // Level up rewards claimed
  claimedRewards Json? // ["reward1", "reward2"]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([level])
  @@index([totalXp])
}

model ForumXpLog {
  id          String   @id @default(uuid())
  userId      String
  user        ForumUserLevel @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amount      Int
  action      String   // post_created, topic_created, reaction_received, daily_login, quest_completed
