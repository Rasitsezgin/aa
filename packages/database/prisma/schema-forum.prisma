  slug        String   @unique
  description String?
  icon        String?
  color       String   @default("blue")
  
  displayOrder Int    @default(0)
  
  pages       ForumWiki[]
  
  createdAt   DateTime @default(now())
  
  @@index([slug])
}

model ForumWikiVersion {
  id          String   @id @default(uuid())
  wikiId      String
  wiki        ForumWiki @relation(fields: [wikiId], references: [id], onDelete: Cascade)
  
  version     Int
  content     String   @db.Text
  summary     String?  // Edit summary
  editorId    String
  
  createdAt   DateTime @default(now())
  
  @@unique([wikiId, version])
}

// ==================== EVENTS & CALENDAR ====================

model ForumEvent {
  id          String   @id @default(uuid())
  
  // Event details
  title       String
  description String?  @db.Text
  descriptionHtml String? @db.Text
  
  // Type
  type        String   @default("webinar") // webinar, meetup, workshop, ama, contest
  
  // Schedule
  startAt     DateTime
  endAt       DateTime?
  timezone    String   @default("Europe/Istanbul")
  
  // Location
  isOnline    Boolean  @default(true)
  location    String?  // Physical address or "Zoom", "Discord", etc.
  meetingUrl  String?
  
  // Organizer
  organizerId String
  
  // Attendees
  attendees   ForumEventAttendee[]
  maxAttendees Int?    // null = unlimited
  
  // Status
  status      String   @default("upcoming") // upcoming, ongoing, ended, cancelled
  
  // Reminders sent
  remindersSent Json?  // ["1_day", "1_hour"]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([startAt])
  @@index([status])
  @@index([type])
}

model ForumEventAttendee {
  id          String   @id @default(uuid())
  eventId     String
  event       ForumEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status      String   @default("registered") // registered, attended, no_show, cancelled
  registeredAt DateTime @default(now())
  
  // Reminder preferences
  reminderEmail Boolean @default(true)
  reminderPush  Boolean @default(true)
  
  @@unique([eventId, userId])
  @@index([userId])
}

// ==================== ADVANCED SEARCH ====================

model ForumSearchIndex {
  id          String   @id @default(uuid())
  
  // Content type
  type        String   // topic, post, wiki
  contentId   String
  
  // Searchable content
  title       String?
  content     String   @db.Text
  authorName  String?
  tags        String[]
  
  // Filters
  boardId     String?
  categoryId  String?
  authorId    String?
  
  // Dates
  createdAt   DateTime
  lastPostAt  DateTime?
  
  // Stats for ranking
  viewCount   Int      @default(0)
  replyCount  Int      @default(0)
  reactionCount Int    @default(0)
  
  @@index([type])
  @@index([contentId])
  @@index([boardId])
  @@index([createdAt])
  @@index([lastPostAt])
}

// ==================== DISCORD/SLACK INTEGRATION ====================

model ForumWebhook {
  id          String   @id @default(uuid())
  
  name        String
  url         String   // Webhook URL (encrypted)
  secret      String?  // For verification
  
  // Platform
  platform    String   @default("discord") // discord, slack, teams, custom
  
  // Triggers
  triggers    Json     // ["new_topic", "new_post", "user_register", "report"]
  
  // Filters
  boardIds    String[] // Only these boards (empty = all)
  
  // Formatting
  format      String   @default("embed") // embed, simple, custom
  customTemplate String? @db.Text
  
  // Status
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  lastError   String?
  errorCount  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive])
  @@index([platform])
}

model ForumWebhookLog {
  id          String   @id @default(uuid())
  webhookId   String
  
  payload     Json
  response    String?  @db.Text
  status      String   // success, failed
  error       String?
  
  createdAt   DateTime @default(now())
  
  @@index([webhookId])
  @@index([createdAt])
}

// ==================== SPAM PROTECTION (AI) ====================

model ForumSpamCheck {
  id          String   @id @default(uuid())
  
  // Content
  type        String   // post, topic, pm, registration
  contentId   String?
  content     String   @db.Text
  authorId    String
  authorIp    String?
  
  // Check results
  isSpam      Boolean?
  confidence  Float?   // 0.0 to 1.0
  reasons     String[] // ["suspicious_links", "keyword_spam", "rapid_posting"]
  
  // AI Analysis
  aiModel     String?  // Which model checked this
  aiResult    Json?    // Raw AI output
  
  // Action taken
  action      String?  // blocked, flagged, allowed, shadow_banned
  
  // Moderator review
  reviewedBy  String?
  reviewedAt  DateTime?
  isFalsePositive Boolean? // Was it wrongly flagged?
  
  createdAt   DateTime @default(now())
  
  @@index([isSpam])
  @@index([authorId])
  @@index([createdAt])
}

// ==================== AUTO-SAVE DRAFTS ====================

model ForumAutoSave {
  id          String   @id @default(uuid())
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Draft type
  type        String   @default("topic") // topic, post, pm, wiki
  
  // Original item (if editing)
  topicId     String?
  postId      String?
  
  // Content
  title       String?
  content     String   @db.Text
  
  // Metadata
  boardId     String?
  tags        String[]
  
  // Auto-save info
  saveCount   Int      @default(1)
  lastSavedAt DateTime @default(now())
  
  @@unique([userId, type, topicId])
  @@index([userId])
  @@index([lastSavedAt])
}

// ==================== USER TIPS / DONATIONS ====================

model ForumUserTip {
  id          String   @id @default(uuid())
  
  // Sender
  senderId    String
  sender      ForumUserProfile @relation("TipSender", fields: [senderId], references: [id], onDelete: Cascade)
  
  // Recipient
  recipientId String
  recipient   ForumUserProfile @relation("TipReceiver", fields: [recipientId], references: [id], onDelete: Cascade)
  
  // Amount (in forum points/credits)
  amount      Int
  
  // Context
  postId      String?
  message     String?  // Thank you message
  
  // Public or anonymous
  isAnonymous Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  
  @@index([recipientId])
  @@index([senderId])
  @@index([createdAt])
}

// ==================== FRIENDSHIP SYSTEM ====================

enum ForumFriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model ForumFriendship {
  id          String   @id @default(uuid())
  
  requesterId String
  requester   ForumUserProfile @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  
  addresseeId String
  addressee   ForumUserProfile @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  
  status      ForumFriendshipStatus @default(PENDING)
  
  requestedAt DateTime @default(now())
  respondedAt DateTime?
  
  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@index([status])
}

// ==================== READ TIME TRACKING ====================

model ForumReadTime {
  id          String   @id @default(uuid())
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  topicId     String?
  topic       ForumTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  
  postId      String?
  
  // Time spent in seconds
  timeSpent   Int      @default(0)
  
  // Session tracking
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  
  @@index([userId])
  @@index([topicId])
  @@index([startedAt])
}

// ==================== IP LOGGING (Security) ====================

model ForumIpLog {
  id          String   @id @default(uuid())
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  ip          String
  userAgent   String?
  
  // Action
  action      String   // login, post_create, topic_create
  contentId   String?
  
  // Location (if available)
  country     String?
  city        String?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([ip])
  @@index([createdAt])
}

// ==================== CUSTOM USER FIELDS ====================

model ForumCustomField {
  id          String   @id @default(uuid())
  
  name        String
  key         String   @unique
  description String?
  
  type        String   // text, textarea, number, date, select, multiselect, url
  options     Json?    // For select/multiselect
  
  // Validation
  required    Boolean  @default(false)
  minLength   Int?
  maxLength   Int?
  pattern     String?  // Regex
  
