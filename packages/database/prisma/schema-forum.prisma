  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([isActive])
}

model ForumUserQuest {
  id          String   @id @default(uuid())
  userId      String
  questId     String
  quest       ForumDailyQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  
  progress    Int      @default(0)
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  
  @@unique([userId, questId])
  @@index([questId])
}

// ==================== LEADERBOARD ====================

model ForumLeaderboard {
  id          String   @id @default(uuid())
  
  // Period
  period      String   // daily, weekly, monthly, all_time
  periodStart DateTime
  periodEnd   DateTime?
  
  // Type
