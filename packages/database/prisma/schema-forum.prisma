  name        String
  description String?
  
  // Template content
  title       String?
  content     String   @db.Text
  
  // Who can use
  boardIds    String[] // Specific boards (empty = all)
  groupIds    String[] // User groups (empty = all)
  
  // Display
  icon        String?
  color       String   @default("blue")
  
  isActive    Boolean  @default(true)
  
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== FEED / ACTIVITY STREAM ====================

model ForumActivity {
  id          String   @id @default(uuid())
  
  // Actor
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Action
