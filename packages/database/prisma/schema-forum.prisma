  createdAt   DateTime @default(now())
}

// ==================== SCREEN SHARING / COLLABORATION ====================

model ForumScreenShare {
  id          String   @id @default(uuid())
  
  // Session
  sessionId   String   @unique
  
  // Host
  hostId      String
  host        ForumUserProfile @relation(fields: [hostId], references: [id], onDelete: Cascade)
  
  // Context
  type        String   @default("support") // support, meeting, presentation, tutoring
  boardId     String?  // For support board
  
  // Info
  title       String?
  description String?
  
  // Status
  status      String   @default("waiting") // waiting, active, ended
  
  // Participants
  viewers     ForumScreenShareViewer[]
  maxViewers  Int      @default(10)
  
  // Recording
  isRecorded  Boolean  @default(false)
  recordingUrl String?
  
  // Timing
  startedAt   DateTime?
  endedAt     DateTime?
  duration    Int?     // Seconds
  
  createdAt   DateTime @default(now())
  
  @@index([hostId])
  @@index([status])
}

model ForumScreenShareViewer {
  id          String   @id @default(uuid())
  
  shareId     String
  share       ForumScreenShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Join info
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  duration    Int      @default(0)
  
  // Permissions
  canControl  Boolean  @default(false)
  canChat     Boolean  @default(true)
  
  @@unique([shareId, userId])
  @@index([userId])
}

// ==================== ADVANCED SEARCH FEATURES ====================

model ForumSavedSearch {
  id          String   @id @default(uuid())
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Search params
  name        String
  query       String?
  
  // Filters
  filters     Json?    // { boards: [...], tags: [...], dateRange: {...} }
  
  // Sort
  sortBy      String   @default("relevance") // relevance, date, views
  sortOrder   String   @default("desc") // asc, desc
  
  // Alerts
  alertEnabled Boolean @default(false)
  lastAlertAt DateTime?
  newResultsCount Int @default(0)
  
  // Stats
  usedCount   Int      @default(0)
  lastUsedAt  DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
}

model ForumSearchSuggestion {
  id          String   @id @default(uuid())
  
  // Suggestion
  query       String
  
  // Popularity
  searchCount Int      @default(1)
  clickCount  Int      @default(0)
  
  // Type
  type        String   @default("suggestion") // suggestion, correction, related
  
  // Related
  relatedTo   String?  // Another query this is related to
  
  // Board/Tag
  boardId     String?
  tagId       String?
  
  lastSearchedAt DateTime @default(now())
  
  @@unique([query])
  @@index([searchCount])
}

// ==================== BULK ACTIONS & AUTOMATION ====================

model ForumBulkAction {
  id          String   @id @default(uuid())
  
  // Who
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // What
  action      String   // move, delete, close, tag, merge
  
  // Target
  targetIds   String[] // Topic IDs or Post IDs
  targetType  String   // topic, post
  
  // Details
  details     Json?    // { toBoardId: "...", reason: "..." }
  
  // Status
  status      String   @default("pending") // pending, processing, completed, failed
  
  // Progress
  processedCount Int   @default(0)
  failedCount  Int    @default(0)
  
  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([status])
}

model ForumAutomationRule {
  id          String   @id @default(uuid())
  
  name        String
  description String?
  
  // Trigger
  trigger     String   // new_topic, new_post, user_register, no_activity, keyword_match
  triggerConditions Json? // { keywords: [...], boards: [...], minPosts: 5 }
  
  // Action
  action      String   // move_topic, close_topic, send_message, add_tag, notify_mod
  actionParams Json?   // { toBoardId: "...", message: "..." }
  
  // Settings
  isActive    Boolean  @default(true)
  runOncePerUser Boolean @default(false)
  
  // Stats
  runCount    Int      @default(0)
  lastRunAt   DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive])
  @@index([trigger])
}

// ==================== DATA EXPORT / GDPR ====================

model ForumDataExport {
  id          String   @id @default(uuid())
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // What to export
  includePosts    Boolean @default(true)
  includeMessages Boolean @default(true)
  includeProfile  Boolean @default(true)
  includeActivity Boolean @default(true)
  
  // Format
  format      String   @default("json") // json, html, pdf
  
  // Status
  status      String   @default("pending") // pending, processing, ready, expired
  
  // File
  fileUrl     String?
  fileSize    Int?
  
  // Expiry
  expiresAt   DateTime?
  
  // Request info
  requestedAt DateTime @default(now())
  completedAt DateTime?
  
  @@index([userId])
  @@index([status])
}

model ForumDataDeletion {
  id          String   @id @default(uuid())
  
  userId      String
  user        ForumUserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // What to delete
  deletePosts     Boolean @default(false) // Anonymize instead
  deleteMessages  Boolean @default(true)
  deleteProfile   Boolean @default(true)
  
  // Keep anonymized
  anonymizePosts  Boolean @default(true)
  
  // Status
  status      String   @default("requested") // requested, processing, completed
  
  // Request
  reason      String?
  requestedAt DateTime @default(now())
  
  // Admin
  reviewedBy  String?
  reviewedAt  DateTime?
  approved    Boolean?
  
  // Execution
  scheduledAt DateTime?
  completedAt DateTime?
  
  @@index([userId])
  @@index([status])
}
