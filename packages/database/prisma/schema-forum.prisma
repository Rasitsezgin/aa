}

// ==================== FORUM STORE / CREDIT SYSTEM ====================

model ForumStoreItem {
  id          String   @id @default(uuid())
  
  name        String
  description String?  @db.Text
  icon        String?
  
  // Type
  type        String   @default("badge") // badge, title, color, effect, perk
  
  // Pricing
  price       Int      // Forum credits
  originalPrice Int?   // For discounts
  
  // Stock
  isLimited   Boolean  @default(false)
  stock       Int?     // null = unlimited
  soldCount   Int      @default(0)
  
  // Availability
  isActive    Boolean  @default(true)
  availableFrom DateTime @default(now())
  availableUntil DateTime?
  
  // Who can buy
  minLevel    Int      @default(1)
  requiredBadgeId String?
  
  // Data
  metadata    Json?    // { badgeId: "...", color: "...", effect: "..." }
  
  purchases   ForumStorePurchase[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
