{
    "manifest_version": 3,
    "name": "Pazaryönetimi.com AI Assistant",
    "version": "1.0.0",
    "description": "Pazaryeri rakip analizi ve içerik otomasyon asistanı",
    "action": {
        "default_popup": "index.html"
    },
    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "https://*.trendyol.com/*",
        "https://*.amazon.com.tr/*",
        "https://*.hepsiburada.com/*",
        "http://localhost:3001/*"
    ],
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.trendyol.com/*",
                "https://*.amazon.com.tr/*",
                "https://*.hepsiburada.com/*"
            ],
            "js": [
                "src/content/index.tsx"
            ]
        }
    ]
}